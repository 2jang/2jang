---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { imageUrl } from '../lib/paths';
import { mainProjects, subProjects, awards, skills, profile, findProject } from '../data/projects';

const base = import.meta.env.BASE_URL;
const pad = (count: number) => String(count).padStart(2, '0');
---

<Base
  title={`${profile.name} · 백엔드 개발자 포트폴리오`}
  description="백엔드 개발자 조현우의 포트폴리오입니다. 화성시 교통 대시보드, 동구라미, Privacy Lens에서 맡은 서버 개발과 배포·운영 경험을 소개합니다."
>
  <section class="hero" aria-labelledby="intro-title">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span class="intro-line" aria-hidden="true"></span>ENGINEERING PORTFOLIO</p>
        <h1 id="intro-title" lang="en">Backend<br />Developer<span aria-hidden="true">.</span></h1>
        <p class="hero-intro">
          안녕하세요, {profile.role} <strong>{profile.name}</strong>입니다.<br />
          서버 개발을 주로 하고, 프론트엔드 구현과 <span class="nowrap">배포·운영도</span> 직접 해 왔습니다.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#projects"><Icon name="layers" size={17} />프로젝트 보기</a>
          <a class="button secondary" href="#about"><Icon name="user" size={17} />개발자 소개</a>
        </div>
      </div>
      <div class="system-art">
        <div class="drawing-field" aria-hidden="true"></div>
        <div class="portrait">
          <img
            class="portrait-photo"
            src={imageUrl('/art/profile.webp')}
            width="720"
            height="900"
            alt={`${profile.name} 사진`}
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="about-section section-space" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <div class="about-intro">
        <p class="eyebrow"><span class="slash" aria-hidden="true">//</span> ABOUT ME</p>
        <h2 id="about-title">개발자 {profile.name}</h2>
        <p>
          운영 중인 서비스의 백엔드를 넘겨받아 유지보수했고, 직접 개발한 서버를 배포해 운영하면서 발생한 문제를
          해결했습니다. 문제가 생기면 먼저 측정으로 원인을 확인하고, 수정한 내용은 테스트 코드로 남깁니다.
        </p>
        <div class="profile-links">
          <a class="profile-link" href={profile.github} target="_blank" rel="noopener">
            <Icon name="github" />github.com/{profile.handle}
          </a>
          <a class="profile-link" href={`mailto:${profile.email}`}>
            <Icon name="mail" />{profile.email}
          </a>
        </div>
      </div>
      <div class="awards" id="awards">
        <h3><Icon name="award" />수상 이력</h3>
        {
          awards.map((award) => {
            const project = findProject(award.project);
            return (
              <a class="award-row" href={project ? `${base}${project.path}` : undefined}>
                <time datetime={award.date.replace('.', '-')}>{award.date}</time>
                <span>
                  <strong>{award.name}</strong>
                  <small>
                    {project?.title} · {award.role}
                  </small>
                </span>
                <b>{award.result}</b>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section id="stack" class="stack-section section-space" aria-labelledby="stack-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow"><span class="slash" aria-hidden="true">//</span> TOOLKIT</p>
          <h2 id="stack-title">기술 스택</h2>
        </div>
      </div>
      <div class="stack-grid">
        {
          skills.map((skill) => (
            <article class="stack-item">
              <Icon name={skill.icon} size={20} />
              <div>
                <h3>{skill.area}</h3>
                <p>{skill.items.join(' · ')}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p class="tool-note">
        2026년 프로젝트에서는 코드 작성과 오류 분석에 AI 코딩 도구(Claude Code)를 활용했습니다. 구조 설계와
        기술 선택은 직접 결정했고, 결과물은 테스트와 측정으로 검증했습니다.
      </p>
    </div>
  </section>

  <section id="projects" class="projects-section section-space" aria-labelledby="projects-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow"><span class="slash" aria-hidden="true">//</span> SELECTED WORK</p>
          <h2 id="projects-title">대표 프로젝트</h2>
        </div>
        <a class="archive-toggle" href="#more">
          그 밖의 프로젝트<span class="count">{pad(subProjects.length)}</span><Icon name="grid" size={14} />
        </a>
      </div>
      <div class="project-grid">
        {mainProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section id="more" class="more-section section-space" aria-labelledby="more-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow"><span class="slash" aria-hidden="true">//</span> MORE WORK</p>
          <h2 id="more-title">그 밖의 프로젝트</h2>
        </div>
      </div>
      <div class="project-grid">
        {subProjects.map((project) => <ProjectCard project={project} lazy />)}
      </div>
    </div>
  </section>
</Base>
