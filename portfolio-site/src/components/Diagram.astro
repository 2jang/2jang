---
// 박스와 화살표로 된 구조도를 SVG로 그린다. 좌표는 src/data/diagrams.ts 에 있다.
import type { DiagramData } from '../data/diagrams';

interface Props extends DiagramData {
  caption?: string;
}

const {
  id,
  label,
  viewBox,
  containers = [],
  boxes,
  diamonds = [],
  arrows = [],
  lines = [],
  labels = [],
  caption,
} = Astro.props;

const markerId = `${id}-arrow`;
---

<figure class="diagram">
  <div class="scroll">
    <svg viewBox={viewBox} role="img" aria-label={label} font-size="13">
      <defs>
        <marker
          id={markerId}
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M0 0L10 5L0 10z" fill="var(--dia-edge)"></path>
        </marker>
      </defs>

      {
        containers.map((c) => (
          <g>
            <rect
              x={c.x}
              y={c.y}
              width={c.w}
              height={c.h}
              rx="8"
              fill="var(--dia-group)"
              stroke="var(--dia-edge)"
              stroke-width="1.25"
            />
            <text x={c.x + 16} y={c.y + 21} font-weight="600" fill="var(--dia-text)">
              {c.name}
            </text>
          </g>
        ))
      }

      {
        lines.map((d) => (
          <path d={d} fill="none" stroke="var(--dia-edge)" stroke-width="1.25" />
        ))
      }
      {
        arrows.map((d) => (
          <path
            d={d}
            fill="none"
            stroke="var(--dia-edge)"
            stroke-width="1.25"
            marker-end={`url(#${markerId})`}
          />
        ))
      }

      {
        boxes.map((b) => (
          <g>
            <rect
              x={b.x}
              y={b.y}
              width={b.w}
              height={b.h}
              rx="8"
              fill={b.main ? 'var(--dia-main)' : 'var(--dia-box)'}
              stroke={b.main ? 'var(--dia-main-edge)' : 'var(--dia-edge)'}
              stroke-width={b.main ? 2 : 1.25}
            />
            <text
              x={b.x + b.w / 2}
              y={b.lines && b.lines.length > 0 ? b.y + 24 : b.y + b.h / 2 + 4}
              text-anchor="middle"
              font-weight="600"
              fill="var(--dia-text)"
            >
              {b.name}
            </text>
            {(b.lines ?? []).map((line, i) => (
              <text
                x={b.x + b.w / 2}
                y={b.y + 40 + 16 * i}
                text-anchor="middle"
                font-size="11.5"
                fill="var(--dia-sub)"
              >
                {line}
              </text>
            ))}
          </g>
        ))
      }

      {
        diamonds.map((d) => (
          <g>
            <polygon
              points={`${d.cx - d.rx},${d.cy} ${d.cx},${d.cy - d.ry} ${d.cx + d.rx},${d.cy} ${d.cx},${d.cy + d.ry}`}
              fill="var(--dia-box)"
              stroke="var(--dia-edge)"
              stroke-width="1.25"
            />
            {d.lines.map((line, i) => (
              <text
                x={d.cx}
                y={d.cy + 4 - (d.lines.length - 1) * 8 + 16 * i}
                text-anchor="middle"
                fill="var(--dia-text)"
              >
                {line}
              </text>
            ))}
          </g>
        ))
      }

      {
        labels.map((l) => (
          <text
            x={l.x}
            y={l.y}
            text-anchor={l.anchor ?? 'start'}
            font-size="11.5"
            font-weight={l.bold ? 600 : 400}
            fill="var(--dia-sub)"
          >
            {l.text}
          </text>
        ))
      }
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
